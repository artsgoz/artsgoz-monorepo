  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "nx run-many -t dev --exclude @artsgoz/source",
    "dev:artsgoz-frontend": "nx dev @artsgoz/artsgoz-frontend",
    "dev:backoffice": "nx dev @artsgoz/artsgoz-backoffice",
    "build": "nx run-many -t build --exclude @artsgoz/source",
    "build:artsgoz-frontend": "nx build @artsgoz/artsgoz-frontend",
    "build:backoffice": "nx build @artsgoz/artsgoz-backoffice",
    "deploy:firebase:artsgoz-develop": "firebase deploy --project artsgoz-develop --only hosting:artsgoz-frontend,hosting:artsgoz-backoffice",
    "deploy:firebase:aksornsara-develop": "firebase deploy --project aksornsara-develop --only hosting:aksornsara-frontend,apphosting:aksornsara-api",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint -- --fix",
    "typecheck": "nx run-many -t typecheck",
    "e2e": "nx run-many -t e2e",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "graph": "nx graph",
    "prepare": "husky",
    "build:tokens": "node ./scripts/build-tokens.js",
    "sync:figma": "node ./scripts/sync-figma.js",
    "sync:figma:json": "node ./scripts/sync-figma.js --json",
    "sync:figma:export": "node ./scripts/sync-figma.js --export-tokens"
  },
  "private": true,
  "engines": {
    "node": ">=22"
